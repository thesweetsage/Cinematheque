# Copy to .env.local. Never commit real values.
TMDB_API_KEY=
OMDB_API_KEY=
# Claude API key: writes the fact cards and liner notes on title pages (console.anthropic.com)
ANTHROPIC_API_KEY=
# Plex: connect it on the Membership card (Settings) instead. Only set these two if that isn't possible;
# when both are set they take over, e.g. PLEX_URL=http://192.168.1.20:32400
PLEX_URL=
PLEX_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# The one email allowed to sign in (Supabase Auth sends it a code). Login is required once Supabase is connected.
MEMBER_EMAIL=
# Optional: signs the session cookie. Defaults to a key derived from SUPABASE_SECRET_KEY.
SESSION_SECRET=
